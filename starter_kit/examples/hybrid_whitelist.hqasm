// Every gate in the twelve-gate whitelist, followed by nested classical logic.
// Used by the LoomQ-Q end-to-end test: the sampled measurement distribution is
// compared against the reference simulator's exact distribution.

OPENQASM 2.0;
include "qelib1.inc";
qreg q[3];
creg c[3];

h q[0];
x q[1];
s q[0];
sdg q[1];
t q[2];
tdg q[2];
rz(pi/3) q[0];
ry(pi/5) q[2];
cx q[0], q[1];
cu1(pi/4) q[1], q[2];
swap q[0], q[2];
ccx q[0], q[1], q[2];

measure q[0] -> c[0];
measure q[1] -> c[1];
measure q[2] -> c[2];

classical {
  if (c[0] == 1) {
    if (c[2] == 1) { r1 = 3; } else { r1 = 2; }
  } else if (c[2] == 1) {
    r1 = 1;
  } else {
    r1 = 0;
  }
  r2 = c[0] + c[1] + c[2];
}
