# LoomQ local credentials — copy to `secrets.env` and fill in.
#
#   cp secrets.env.example secrets.env
#
# `secrets.env` is gitignored and is never read by adapter.py, the evaluator or
# anything that runs during scoring. Only the tools under tools/ load it, and
# only when you run them yourself. Nothing here is ever printed, logged or
# written into a result file.
#
# Formal scoring injects LOOMQ_LLM_* itself; this file is purely for testing
# locally before submission.

# ---------------------------------------------------------------- L2 (20 pts)
# DeepSeek: https://platform.deepseek.com  ->  API keys  ->  create
LOOMQ_LLM_BASE_URL=https://api.deepseek.com
LOOMQ_LLM_API_KEY=
LOOMQ_LLM_MODEL=deepseek-v4-flash
LOOMQ_LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------- L1 real hardware (+5 each)
# SpinQ Cloud: https://cloud.spinq.cn
#   register -> console -> generate and download the private key file
#   LOOMQ_SPINQ_KEYFILE is a path on this machine, not the key text
LOOMQ_SPINQ_USERNAME=
LOOMQ_SPINQ_KEYFILE=
# optional: gemini_vp (2q) | triangulum_vp (3q) | superconductor_vp (8q)
LOOMQ_SPINQ_PLATFORM=

# Origin Quantum: https://qcloud.originqc.com.cn/zh
#   register -> real-name verification -> personal centre -> API token
LOOMQ_ORIGINQ_TOKEN=
# optional: origin_72 is the Wukong chip
LOOMQ_ORIGINQ_CHIP=origin_72
